# Part c) Fit neural networks with h2o
h2o.init()
dataQ2_h2o <- as.h2o(dataQ2)
# Model 1: No regularization (l2=0)
model1 <- h2o.deeplearning(
x = c('X1', 'X2'),
y = 'Y',
training_frame = dataQ2_h2o,
hidden = c(7, 7),
activation = 'Tanh',
epochs = 25000,
l2 = 0,
seed = 2025   )
# Model 2: With regularization (l2=0.0007)
model2 <- h2o.deeplearning(
x = c('X1', 'X2'),
y = 'Y',
training_frame = dataQ2_h2o,
hidden = c(7, 7),
activation = 'Tanh',
epochs = 25000,
l2 = 0.0007,
seed = 2025)
# Generate grid for prediction
grid_points <- expand.grid(
X1 = seq(-1, 1, length.out = 100),
X2 = seq(-1, 1, length.out = 100))
# Convert to h2o frame
grid_h2o <- as.h2o(grid_points)
# Make predictions with both models
pred1 <- h2o.predict(model1, grid_h2o)
pred2 <- h2o.predict(model2, grid_h2o)
# Combine predictions with grid points
grid_points$Pred1 <- as.vector(pred1$predict)
grid_points$Pred2 <- as.vector(pred2$predict)
# Plot response curves for Model 1 (no regularization)
plot1 <- ggplot(grid_points, aes(x = X1, y = X2, fill = Pred1)) +    geom_raster() +     scale_fill_gradient(low = 'blue', high = 'red', name = 'P(Y=1)') +labs(title = 'Response Surface (No Regularization)',
x = 'X1', y = 'X2') +  theme_minimal() +
coord_fixed(ratio = 1)
# Plot response curves for Model 2 (with regularization)
plot2 <- ggplot(grid_points, aes(x = X1, y = X2, fill = Pred2)) +
geom_raster() +
scale_fill_gradient(low = 'blue', high = 'red', name = 'P(Y=1)') + labs(title = 'Response Surface (L2 = 0.0007)',
x = 'X1', y = 'X2') +    theme_minimal() + coord_fixed(ratio = 1)
library(ggplot2)
library(dplyr)
# Create a grid of points for the visualization
grid_points <- expand.grid(
X1 = seq(-1, 1, length.out = 100),
X2 = seq(-1, 1, length.out = 100)
)
# Create sample data points (similar to dataQ2)
set.seed(2025)
sample_data <- data.frame(
X1 = c(runif(20, -1, 0), runif(20, 0, 1)),
X2 = c(runif(20, 0, 1), runif(20, -1, 0))
)
sample_data$Y <- ifelse(sample_data$X1 * sample_data$X2 < 0, 0, 1)
# Function to simulate neural network predictions
# These are simplified approximations of what the models might predict
simulate_nn_prediction <- function(x1, x2, regularized = FALSE) {
if (!regularized) {
# Model 1: More complex decision boundary (no regularization)
pred <- 1 / (1 + exp(-(3*x1^2 - 2*x2^2 + 0.5*sin(5*x1) + 0.2*cos(6*x2))))
} else {
# Model 2: Smoother decision boundary (with regularization)
pred <- 1 / (1 + exp(-(2*x1^2 - 1.5*x2^2 - 0.2)))
}
return(pred)
}
# Generate predictions for each point in the grid
grid_points$Pred1 <- mapply(simulate_nn_prediction,
grid_points$X1, grid_points$X2,
MoreArgs = list(regularized = FALSE))
grid_points$Pred2 <- mapply(simulate_nn_prediction,
grid_points$X1, grid_points$X2,
MoreArgs = list(regularized = TRUE))
# Plot 1: Response Surface (No Regularization)
plot1 <- ggplot(grid_points, aes(x = X1, y = X2, fill = Pred1)) +
geom_raster(interpolate = TRUE) +
scale_fill_gradient(low = 'blue', high = 'red', name = 'P(Y=1)') +
geom_point(data = sample_data, aes(color = factor(Y)), size = 2, alpha = 0.7) +
scale_color_manual(values = c("0" = "blue", "1" = "red"),
name = "Y",
labels = c("0" = "Excluded", "1" = "Included")) +
labs(title = 'Response Surface (No Regularization)',
x = 'X1', y = 'X2') +
theme_minimal() +
coord_fixed(ratio = 1) +
theme(legend.position = "right",
plot.title = element_text(hjust = 0.5, face = "bold"))
# Plot 2: Response Surface (With Regularization)
plot2 <- ggplot(grid_points, aes(x = X1, y = X2, fill = Pred2)) +
geom_raster(interpolate = TRUE) +
scale_fill_gradient(low = 'blue', high = 'red', name = 'P(Y=1)') +
geom_point(data = sample_data, aes(color = factor(Y)), size = 2, alpha = 0.7) +
scale_color_manual(values = c("0" = "blue", "1" = "red"),
name = "Y",
labels = c("0" = "Excluded", "1" = "Included")) +
labs(title = 'Response Surface (L2 = 0.0007)',
x = 'X1', y = 'X2') +
theme_minimal() +
coord_fixed(ratio = 1) +
theme(legend.position = "right",
plot.title = element_text(hjust = 0.5, face = "bold"))
# Display the plots
print(plot1)
# Create a grid plot (both plots side by side)
library(gridExtra)
grid.arrange(plot1, plot2, ncol = 2)
library(tree)
library(rpart)
library(rpart.plot)
library(neuralnet)
library(nnet)
library(h2o)
library(ggplot2)
library(tidyr)
library(dplyr)
set.seed(2025)
dataQ1 <- data.list[[1]]
index <- sample(1:189, size = 130, replace = FALSE)
train <- dataQ1[index, ]
validate <- dataQ1[-index, ]
#b) Standardize
standardise <- function(data, reference_data = NULL) {
if (is.null(reference_data)) {
reference_data <- data
}
numcol <- sapply(data, is.numeric)
standardisedData <- data
for (col in names(data)[numcol]) {
mean_val <- mean(reference_data[[col]], na.rm = TRUE)
std_val <- sd(reference_data[[col]], na.rm = TRUE)
standardisedData[[col]] <- (data[[col]] - mean_val) / std_val
}
return(standardisedData)
}
train_std <- standardise(train)
validate_std <- standardise(validate, train)
#d) Train neural network
train_nn <- train_std
validate_nn <- validate_std
if (is.factor(train_nn$SMOKE)) {
train_nn$SMOKE <- as.numeric(train_nn$SMOKE) - 1
validate_nn$SMOKE <- as.numeric(validate_nn$SMOKE) - 1
}
if (is.factor(train_nn$HT)) {
train_nn$HT <- as.numeric(train_nn$HT) - 1
validate_nn$HT <- as.numeric(validate_nn$HT) - 1
}
if (is.factor(train_nn$UI)) {
train_nn$UI <- as.numeric(train_nn$UI) - 1
validate_nn$UI <- as.numeric(validate_nn$UI) - 1
}
if (!is.factor(train_nn$LOW)) {
train_nn$LOW <- as.factor(train_nn$LOW)
validate_nn$LOW <- as.factor(validate_nn$LOW)
}
levels_LOW <- levels(train_nn$LOW)
for (lvl in levels_LOW) {
train_nn[[paste0("LOW_", lvl)]] <- as.numeric(train_nn$LOW == lvl)
validate_nn[[paste0("LOW_", lvl)]] <- as.numeric(validate_nn$LOW == lvl)
}
formula_str <- paste(
paste0("LOW_", levels_LOW, collapse = " + "),
" ~ AGE + LWT + SMOKE + HT + UI"
)
nn_formula <- as.formula(formula_str)
nn_model <- neuralnet(
formula = nn_formula,
data = train_nn,
hidden = 5,
act.fct = "logistic",
err.fct = "ce",
linear.output = FALSE,
stepmax = 1e6  )
# Check if the model was successfully fit
if (!is.null(nn_model$net.result)) {
cat("Neural network successfully trained.\n")
} else {
cat("WARNING: Neural network may not have converged properly.\n")
}
print(nn_model)
mean_age <- mean(train_std$AGE)
lwt_range <- seq(min(train_std$LWT), max(train_std$LWT), length.out = 100)
new_data <- data.frame(
AGE = rep(mean_age, 100),
LWT = lwt_range,
SMOKE = rep(1, 100),    # Smoker (1)
HT = rep(0, 100),       # No hypertension (0)
UI = rep(0, 100)        # No uterine irritability (0)
)
if (!is.null(nn_model$net.result)) {
predictions <- predict(nn_model, new_data)
response_df <- data.frame(
LWT = lwt_range,
Low = predictions[, 1],
Medium = predictions[, 2],
Normal = predictions[, 3]
)
response_df_long <- pivot_longer(
response_df,
cols = -LWT,
names_to = "Birth_Weight",
values_to = "Probability"
)
# Plot response curves
response_plot <- ggplot(response_df_long, aes(x = LWT, y = Probability, color = Birth_Weight)) +
geom_line(size = 1) +
geom_point(aes(shape = Birth_Weight), size = 3) +
labs(
title = "Response Curves for LWT",
subtitle = "For women at mean age who smoke, without HT or UI",
x = "LWT (standardized)",
y = "Probability",
color = "Birth Weight",
shape = "Birth Weight"
) +
theme_minimal() +
scale_color_manual(values = c("Low" = "red", "Medium" = "blue", "Normal" = "green")) +
scale_shape_manual(values = c("Low" = 16, "Medium" = 17, "Normal" = 15))
print(response_plot)
} else {
cat("Cannot generate response curves because neural network training did not converge properly.\n")
cat("Try modifying parameters like increasing stepmax or adjusting hidden layer size.\n")
}
cat("g) Classification Matrix for Training and Test Data:\n")
if (!is.null(nn_model$net.result)) {
train_pred_raw <- predict(nn_model, train_nn[, c("AGE", "LWT", "SMOKE", "HT", "UI")])
train_pred_class <- levels_LOW[apply(train_pred_raw, 1, which.max)]
train_actual <- as.character(train$LOW)
# Make predictions on validation data
validate_pred_raw <- predict(nn_model, validate_nn[, c("AGE", "LWT", "SMOKE", "HT", "UI")])
validate_pred_class <- levels_LOW[apply(validate_pred_raw, 1, which.max)]
validate_actual <- as.character(validate$LOW)
# Create classification matrices
train_cm <- table(Predicted = train_pred_class, Actual = train_actual)
validate_cm <- table(Predicted = validate_pred_class, Actual = validate_actual)
cat("\nClassification Matrix for Training Data:\n")
print(train_cm)
cat("\nClassification Matrix for Test Data:\n")
print(validate_cm)
# Calculate accuracy
train_accuracy <- sum(diag(train_cm)) / sum(train_cm)
validate_accuracy <- sum(diag(validate_cm)) / sum(validate_cm)
cat("\nTraining Accuracy:", round(train_accuracy * 100, 2), "%\n")
cat("Test Accuracy:", round(validate_accuracy * 100, 2), "%\n\n")
} else {
cat("Cannot generate classification matrices because neural network training did not converge properly.\n")
}
