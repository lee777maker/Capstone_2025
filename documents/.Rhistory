payoff <- matrix(c(60,120,90,80),nrow = 2, byrow = T)
colnames(payoff) <- c("Low (10%)", "High (20%)")
rownames(payoff)<- c("Accept", "Reject")
payoff
prior.probs <- c(0.7,0.3)
exp.profit <- payoff %*% prior.probs
exp.profit
x=0:5
cond.probs <- matrix(nrow = 6, ncol = 2)
cond.probs
cond.probs <- cbind(dbinom(x,5,0.1), dbinom(x,5,0.2))
colnames(cond.probs) <- colnames(payoff)
cond.probs
joint.probs <- t(apply(cond.probs,1,function(x) x*prior.probs))
joint.prob
joint.probs
pred.probs <- rowSums(joint.probs)
pred.probs
posterior <- joint.probs / pred.probs
posterior
posterior.exp.profit <- payoff %*% posterior[1,]
posterior.exp.profit
if (dim(posterior)[1]>1){
for (i in 2:dim(posterior)[1]){
ptemp <- payoff %*% posterior[i,]
posterior.exp.profit <- cbind(posterior.exp.profit,ptemp)
}
}
posterior.exp.profit
profit.PI <- apply(payoff,2,min) %*% prior.probs
profit.PI
min(exp.profit)
EVPI <- min(exp.profit)-profit.PI
predictive.exp <- apply(posterior.exp.profit,2,min) %*% pred.probs
predictive.exp
EVSI <- min(exp.profit) - predictive.ex
EVSI <- min(exp.profit) - predictive.exp
EVSI
EVPI
